{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROJECT_RECORD.schema.json",
  "title": "Project Observatory Project Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "name", "repository", "canonical_ref", "canonical_commit", "state", "observed_at", "sources"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "canonical_ref": {"type": ["string", "null"]},
    "canonical_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "state": {"enum": ["ACTIVE", "BLOCKED_EXTERNAL", "WAITING_FOR_EVIDENCE", "FROZEN", "READY_FOR_NEXT_OPERATION", "SUPERSEDED", "DORMANT", "UNKNOWN"]},
    "summary": {"type": "string"},
    "accepted_results": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_triggers": {"type": "array", "items": {"type": "string"}},
    "superseded_material": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "ref": {"type": ["string", "null"]}, "commit": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "notes": {"type": "string"}
  }
}
